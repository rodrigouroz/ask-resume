{
  "name": "ask-rodrigo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run profile:check && node scripts/clean-build.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint --type-aware --type-check --deny-warnings .",
    "format": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --write .",
    "format:check": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "fallow:check": "node scripts/fallow-audit.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "npm run hooks:install",
    "profile:check": "node scripts/profile-check.mjs",
    "logos:suggest": "node scripts/logos-suggest.mjs",
    "eval:live": "node scripts/eval-live.mjs",
    "cv:pdf": "npm run build && node scripts/generate-cv.mjs",
    "deploy": "npm run cv:pdf && node scripts/deploy.mjs",
    "deploy:production": "npm run cv:pdf && node scripts/deploy.mjs --production",
    "verify:live": "node scripts/verify-live.mjs",
    "cf:types:generate": "wrangler types --env-file .dev.vars.example",
    "cf:types": "wrangler types --env-file .dev.vars.example --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run cf:types"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "openai": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fallow": "2.104.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
