{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "noEmit": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "vite.config.ts",
    "src/evidence.ts",
    "src/profile.ts",
    "src/profileSchema.ts",
    "src/seo.ts",
    "src/workerRuntimeConfig.ts"
  ]
}
