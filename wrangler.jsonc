{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ask-rodrigo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [],
  "workers_dev": true,
  "vars": {
    "AI_PROVIDER": "openai",
    "WORKERS_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "PROFILE_SLUG": "ask-rodrigo",
    "DAILY_ASK_LIMIT": "250",
  },
  "ai": {
    "binding": "AI",
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ASK_DAILY_BUDGET",
        "class_name": "AskDailyBudget",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AskDailyBudget"],
    },
  ],
}
