{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ask-rodrigo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "rodrigouroz.com/*", "zone_name": "rodrigouroz.com" },
    { "pattern": "www.rodrigouroz.com/*", "zone_name": "rodrigouroz.com" },
  ],
  "secrets": {
    "required": ["OPENAI_API_KEY"],
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "ratelimits": [
    {
      "name": "ASK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ASK_DAILY_BUDGET",
        "class_name": "AskDailyBudget",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AskDailyBudget"],
    },
  ],
}
